{
  "description": "taskmap: a one-line map summary at session start (and the whole tree after compaction, since SessionStart fires with source=compact), a one-time Stop check for nodes left in progress, and an optional long-prompt reminder (off unless `taskmap config prompt-reminder on`).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/taskmap hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/taskmap hook stop",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/taskmap hook prompt",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
